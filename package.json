{
	"name": "rightof",
	"version": "1.0.0",
	"description": "Render reladraw diagrams in your notes.",
	"type": "module",
	"license": "MIT",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.5",
		"esbuild": "^0.25.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"jsdom": "^26.1.0",
		"obsidian": "^1.13.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.1",
		"vitest": "^3.2.7"
	},
	"dependencies": {
		"reladraw": "0.15.1"
	}
}
